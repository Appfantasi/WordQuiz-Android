
{
  "name": "wordquiz-android",
  "version": "1.0.0",
  "private": true,
  "description": "WordQuiz Android app built from the existing HTML app",
  "scripts": {
    "build": "npx cap sync android",
    "build:tts": "esbuild tts-bridge.js --bundle --format=iife --outfile=www/tts-bridge.js",
    "postinstall": "npm run build:tts"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.3",
    "@capacitor/core": "^7.4.3",
    "@capacitor-community/text-to-speech": "^6.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.3",
    "esbuild": "^0.25.0"
  }
}
